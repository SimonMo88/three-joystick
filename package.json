{
  "name": "three-joystick",
  "version": "2.0.0",
  "description": "A virtual joystick for three.js scenes",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --config vite.examples.config.ts",
    "build": "npm run build:lib && npm run build:types",
    "build:lib": "vite build",
    "build:types": "tsc --project tsconfig.build.json",
    "build:examples": "vite build --config vite.examples.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fried-Chicken/three-joystick.git"
  },
  "keywords": [
    "three.js",
    "three",
    "canvas",
    "joystick",
    "webgl",
    "touch",
    "pointer-events"
  ],
  "author": "Fried-Chicken <Fried-Chicken@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Fried-Chicken/three-joystick/issues"
  },
  "homepage": "https://github.com/Fried-Chicken/three-joystick#readme",
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "jsdom": "^29.1.1",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
